# Required for PostgreSQL-backed application data
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required by the API server and Vite dev server
PORT=8080
BASE_PATH=/

# Required for AI CV analysis and career recommendation explanations
RUNPOD_BASE_URL=https://YOUR-RUNPOD-ENDPOINT
RUNPOD_API_KEY=
RUNPOD_MODEL_NAME=

# Optional: protect data administration endpoints
CAREER_DATA_ADMIN_TOKEN=

# Optional: Adzuna integration. Leave usage disabled unless your account is authorized.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_USAGE_APPROVED=false
ADZUNA_AUTO_REFRESH_COUNTRIES=SG
ADZUNA_AUTO_REFRESH_INTERVAL_HOURS=24
